(version 1)
(rule jlcpcb_minimum
  (constraint track_width (min 0.12mm))
  (constraint clearance (min 0.2mm))
  (constraint hole_size (min 0.2mm)))
(rule power_track_width
  (constraint track_width (min 0.22mm))
  (condition "A.hasNetclass('MAIN-Power')"))
(rule power_neck_down_at_fine_pitch_pins
  (constraint track_width (min 0.15mm))
  (condition "A.hasNetclass('MAIN-Power') && (A.intersectsCourtyard('U1') || A.intersectsCourtyard('U2') || A.intersectsCourtyard('U4') || A.intersectsCourtyard('U6') || A.intersectsCourtyard('K1') || A.intersectsCourtyard('K2'))"))
(rule neck_down_at_fine_pitch_pins
  (constraint track_width (min 0.1mm))
  (condition "A.intersectsCourtyard('U1') || A.intersectsCourtyard('U2') || A.intersectsCourtyard('U4') || A.intersectsCourtyard('U6') || A.intersectsCourtyard('K1') || A.intersectsCourtyard('K2')"))
(rule parts_under_raised_modules
  (constraint courtyard_clearance (min -100mm))
  (condition "A.Reference == 'U3' || B.Reference == 'U3'"))
